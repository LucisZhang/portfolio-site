server {
    listen 80;
    server_name __PREVIEW_HOST__;

    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/portfolio-preview-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://__PREVIEW_HOST__$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __PREVIEW_HOST__;

    access_log /var/log/nginx/portfolio-preview-public.access.log;
    error_log /var/log/nginx/portfolio-preview-public.error.log warn;

    ssl_certificate /etc/letsencrypt/live/__PREVIEW_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PREVIEW_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PortfolioPreviewTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 32k;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=300" always;

    # The public server overwrites all visitor-address headers before handing
    # the request to the dedicated loopback ingress. External clients cannot
    # choose the HMAC rate-limit identity seen by the application.
    proxy_set_header X-Portfolio-Client-IP $remote_addr;
    proxy_set_header X-Real-IP "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Vercel-Forwarded-For "";
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Host __PREVIEW_HOST__;
    proxy_set_header X-Forwarded-Host __PREVIEW_HOST__;
    proxy_set_header X-Forwarded-Proto https;

    location = /_vps/health {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
    }
}
