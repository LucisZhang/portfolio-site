{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-artifact-catalog.mjs --check && node scripts/generate-portfolio-search-aliases.mjs --check && node scripts/sync-privacy-browser-assets.mjs && node scripts/sync-duckdb-browser-assets.mjs && node scripts/sync-triage-ort-assets.mjs && node scripts/generate-analytics-fixtures.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-artifact-catalog.mjs --check && node scripts/generate-portfolio-search-aliases.mjs --check && node scripts/sync-privacy-browser-assets.mjs && node scripts/sync-duckdb-browser-assets.mjs && node scripts/sync-triage-ort-assets.mjs && node scripts/generate-analytics-fixtures.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:assistant": "node --import ./tests/assistant/register-loader.mjs --test tests/assistant/*.test.mjs tests/count-up.test.mjs",
    "test:e2e": "npm run verify:artifacts && npm run verify:assistant && npm run verify:zh-phrase && npm run verify:zh-token-parity && npm run build && playwright test",
    "build:assistant-knowledge": "node scripts/build-assistant-knowledge.mjs && node --import ./tests/assistant/register-loader.mjs scripts/generate-ask-question-bank.mjs",
    "verify:assistant-public-sources": "node scripts/build-assistant-knowledge.mjs --verify && node --import ./tests/assistant/register-loader.mjs scripts/generate-ask-question-bank.mjs --check",
    "verify:assistant-question-bank": "node --import ./tests/assistant/register-loader.mjs --test tests/assistant/ask-question-bank.test.mjs",
    "verify:assistant-legacy-p1-sources": "node --import ./tests/assistant/register-loader.mjs scripts/check-assistant-public-sources.mjs",
    "generate:analytics": "node scripts/generate-analytics-fixtures.mjs",
    "generate:analytics-parquet": "node scripts/generate-analytics-parquet.mjs",
    "generate:credit-preview": "node scripts/generate-credit-backtest-preview.mjs",
    "generate:credit-policy-frontier": "node scripts/generate-credit-policy-frontier.mjs",
    "generate:olist-preview": "node scripts/generate-olist-margin-preview.mjs",
    "generate:privacy": "node scripts/generate-privacy-examples.mjs && node scripts/generate-privacy-localized-proof-assets.mjs && node scripts/update-privacy-evidence-manifest.mjs",
    "generate:privacy-localized-proof": "node scripts/generate-privacy-localized-proof-assets.mjs && node scripts/update-privacy-evidence-manifest.mjs",
    "generate:search-aliases": "node scripts/generate-portfolio-search-aliases.mjs",
    "generate:ask-question-bank": "node --import ./tests/assistant/register-loader.mjs scripts/generate-ask-question-bank.mjs",
    "generate:ask-recorded-example": "node --import ./tests/assistant/register-loader.mjs scripts/generate-ask-recorded-example.mjs",
    "generate:home-data": "node scripts/generate-home-data.mjs",
    "verify:home-receipts": "node --test tests/home-receipts.test.mjs",
    "generate:home-thumbnails": "node scripts/generate-home-thumbnails.mjs",
    "generate:forge-receipts": "node scripts/generate-forge-receipts.mjs",
    "generate:eod-receipts": "node scripts/generate-eod-receipts.mjs",
    "generate:eod-log-summary": "node scripts/generate-eod-log-summary.mjs",
    "benchmark:privacy-ocr": "node scripts/run-privacy-ocr-benchmark.mjs",
    "verify:projects": "node --import ./tests/assistant/register-loader.mjs --test tests/projects-catalog.test.mjs tests/project-repositories.test.mjs tests/site-circuit.test.mjs",
    "verify:evidence": "npm run verify:projects && node scripts/generate-evidence-links.mjs --check && node --test tests/evidence-receipts.test.mjs tests/margin-report-validation.test.mjs && node scripts/generate-olist-margin-preview.mjs --check && node scripts/generate-credit-backtest-preview.mjs --check && node scripts/generate-credit-policy-frontier.mjs --check && node scripts/verify-evidence.mjs",
    "verify:r2-sources": "node scripts/verify-r2-sources.mjs",
    "verify:zh-glyphs": "node scripts/verify-zh-glyphs.mjs",
    "verify:zh-phrase": "node --import ./tests/assistant/register-loader.mjs --test tests/zh-phrase.test.mjs tests/zh-jsx.test.mjs tests/ts-loader.test.mjs",
    "verify:zh-token-parity": "node --import ./tests/assistant/register-loader.mjs scripts/verify-zh-token-parity.mjs",
    "test:zh-lineation": "playwright test tests/e2e/zh-lineation.spec.ts --project=desktop --project=lineation-webkit",
    "generate:zh-serif-subset": "node scripts/subset-zh-serif.mjs",
    "generate:zh-home-serif-subset": "node scripts/subset-home-zh-serif.mjs",
    "verify:heavy-assets": "node scripts/verify-heavy-assets.mjs",
    "verify:performance": "node scripts/verify-performance-budget.mjs",
    "audit:public-review": "node scripts/audit-public-review.mjs",
    "capture:public-review": "node scripts/capture-public-review.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:repositories": "node --import ./tests/assistant/register-loader.mjs scripts/check-project-repositories.mjs",
    "check:localization": "node --test tests/check-localization-gate-wiring.test.mjs && node scripts/lint-copy.mjs && node scripts/check-localization.mjs && node scripts/verify-zh-glyphs.mjs",
    "generate:artifacts": "node scripts/generate-artifact-catalog.mjs",
    "verify:artifacts": "node scripts/generate-artifact-catalog.mjs --check && node --import ./tests/assistant/register-loader.mjs --test tests/artifacts.test.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.2.10",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/papaparse": "^5.5.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@xyflow/react": "^12.8.0",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.16.1",
    "minisearch": "^7.2.0",
    "next": "16.2.11",
    "onnxruntime-web": "^1.27.0",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.27.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
